# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=
# Shared passcode for all crew devices
CREW_PASSCODE=
# 32+ random characters, signs crew and screen cookies (openssl rand -base64 48)
SESSION_SECRET=
# Random token in the big-screen link (openssl rand -hex 16)
SCREEN_TOKEN=
# Public site URL encoded in the QR code, e.g. https://fear.example.org
PUBLIC_URL=
# Event window, ISO-8601 with offset (Edmonton is -06:00 on Oct 30, 2026)
EVENT_START=
EVENT_END=
# When photos stop being served and are purged (-07:00 after Nov 1)
PHOTO_DELETE_AT=
# Directory for photo files (a private Docker volume in production)
PHOTO_DIR=
# Production domain for Caddy HTTPS
DOMAIN=
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
